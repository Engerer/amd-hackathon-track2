{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMD ACT II Track 2 Caption Output",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["video_id", "source_path", "observations", "captions"],
    "properties": {
      "video_id": {"type": "string"},
      "source_path": {"type": "string"},
      "observations": {
        "type": "object",
        "required": ["setting", "subjects", "actions", "sequence", "visible_text", "audio_or_speech", "uncertainties"],
        "properties": {
          "setting": {"type": "string"},
          "subjects": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}},
          "sequence": {"type": "array", "items": {"type": "string"}},
          "visible_text": {"type": "array", "items": {"type": "string"}},
          "audio_or_speech": {"type": "array", "items": {"type": "string"}},
          "uncertainties": {"type": "array", "items": {"type": "string"}}
        }
      },
      "captions": {
        "type": "object",
        "required": ["formal", "sarcastic", "humorous_tech", "humorous_non_tech"],
        "properties": {
          "formal": {"type": "string"},
          "sarcastic": {"type": "string"},
          "humorous_tech": {"type": "string"},
          "humorous_non_tech": {"type": "string"}
        }
      },
      "checks": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "accuracy": {"type": "string"},
            "tone": {"type": "string"},
            "notes": {"type": "string"}
          }
        }
      }
    }
  }
}
